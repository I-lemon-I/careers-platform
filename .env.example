# Copy this file to .env and fill in the values before running `docker compose up`.

# Required: secret used to sign JWT login tokens. Use a long random string.
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d

# Database (defaults are fine for local development)
DB_NAME=careers_db
DB_USER=postgres
DB_PASSWORD=postgres

# Admin account created by setup-db.sh (change the password after first login)
SEED_ADMIN_EMAIL=admin@careers.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# pgAdmin (optional, start with: docker compose --profile tools up -d)
PGADMIN_EMAIL=admin@careers.local
PGADMIN_PASSWORD=admin
